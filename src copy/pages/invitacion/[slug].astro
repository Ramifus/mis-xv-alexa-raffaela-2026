---
// src/pages/invitacion/[slug].astro
// Invitación personalizada por invitado (nombre y número de pases salen de
// src/data/invitados.json). Mantener el mismo orden de componentes que
// index.astro para que no se desincronicen las dos versiones.
import invitados from "../../data/invitados.json";
import Layout from "../../layouts/Layout.astro";

import Portada from "../../components/Portada.astro";
import Bienvenida from "../../components/Bienvenida.astro";
import NombresPadres from "../../components/NombresPadres.astro";
import Fecha from "../../components/Fecha.astro";
import Ubicacion from "../../components/Ubicacion.astro";
import MomentosEspeciales from "../../components/MomentosEspeciales.astro";
import Pase from "../../components/Pase.astro";
import CodigoVestimenta from "../../components/CodigoVestimenta.astro";
import Regalos from "../../components/Regalos.astro";
import Confirmacion from "../../components/Confirmacion.astro";
import Cierre from "../../components/Cierre.astro";

export function getStaticPaths() {
    return invitados.map((inv) => ({
        params: { slug: inv.slug },
        props: { nombre: inv.nombre, pase: inv.pase },
    }));
}

const { nombre, pase } = Astro.props;
---

<Layout title="Mis XV">
    <Portada nombre={nombre} pase={pase} />
    <Bienvenida />
    <NombresPadres />
    <Fecha />
    <Ubicacion />
    <MomentosEspeciales />
    <Pase numeroPases={pase} />
    <CodigoVestimenta />
    <Regalos />
    <Confirmacion />
    <Cierre />
</Layout>
