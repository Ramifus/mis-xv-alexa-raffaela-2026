---
// src/layouts/Layout.astro
import "../styles/global.css";
export interface Props {
  title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="es" class="m-0 p-0">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- La invitación YA es un diseño oscuro. Al declararlo, Chrome / Android
         Auto Dark Theme / WebView desactivan su "Force Dark" y dejan de
         invertir los colores propios (el dorado #ffc065 se veía rojizo). -->
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#16304d" />
    <link rel="icon" type="image/png" href="/imagenes/corona.png" />
    <link rel="shortcut icon" type="image/png" href="/imagenes/corona.png" />
    <link rel="apple-touch-icon" href="/imagenes/corona.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Great+Vibes&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Great+Vibes&family=Crimson+Text:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Great+Vibes&family=Crimson+Text:wght@400;600;700&family=Cormorant+Garamond:ital,wght@0,300;0,400;1,300;1,400&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Charm:wght@400;700&display=swap"
      rel="stylesheet"
    />

    <style>
      /* ═══════════════════════════════════════════════════════════
         COLORES BLOQUEADOS: el diseño se ve igual en cualquier
         navegador / sistema operativo, con o sin modo oscuro.

         1) color-scheme: dark  -> la página declara que YA es oscura,
            así el navegador no aplica su propio Force Dark encima.
         2) forced-color-adjust: none -> ignora el Alto Contraste de
            Windows y el "Smart Invert" de iOS, que repintan todo.
         ═══════════════════════════════════════════════════════════ */
      :root {
        color-scheme: dark;
        forced-color-adjust: none;
      }

      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
        forced-color-adjust: none;
        -webkit-text-size-adjust: 100%;
        text-size-adjust: 100%;
      }

      html {
        width: 100%;
        height: 100%;
        overflow-x: hidden;
        color-scheme: dark;
        background-color: transparent;
      }

      body {
        margin: 0;
        padding: 0;
        width: 100%;
        min-height: 100vh;
        overflow-x: hidden;
        background-color: transparent;
        color-scheme: dark;
        position: relative;
      }

      /* Titileo de estrellas */
      @keyframes brillo {
        0%, 100% { opacity: 0.15; transform: scale(0.85); }
        50%      { opacity: 1;    transform: scale(1.15); }
      }

      /* Textura de fondo con opacidad */
      @keyframes fondoZoom {
        0%, 100% { transform: scale(1); }
        50%      { transform: scale(1.1); }
      }

      body::before {
        content: "";
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-image: url("/imagenes/fondoverde.png");
        background-size: 100% 100%;
        background-position: center;
        background-repeat: no-repeat;
        opacity: 1;
        z-index: -1;
        pointer-events: none;
      }

      main {
        background: transparent !important;
      }

      /* ANTI-PARPADEO (FOUC): ocultar el contenido hasta que GSAP prepare
         las animaciones de entrada; luego se revela suavemente. Así ningún
         componente aparece un instante antes de ser ocultado por gsap.from(). */
      main {
        opacity: 0;
      }
      html.contenido-listo main {
        opacity: 1;
        transition: opacity 0.35s ease;
      }

      /* El diseño es el MISMO con el sistema en claro o en oscuro: no se
         define ninguna variante, así que prefers-color-scheme no cambia nada.
         Se deja explícito para que ningún estilo futuro lo reintroduzca. */
      @media (prefers-color-scheme: light),
             (prefers-color-scheme: dark) {
        html,
        body {
          background-color: transparent;
          color: inherit;
        }
      }

      /* ALTO CONTRASTE DE WINDOWS: por defecto reemplaza todos los colores
         por la paleta del sistema. Aquí se conservan los originales. */
      @media (forced-colors: active) {
        * {
          forced-color-adjust: none !important;
        }
      }
    </style>
  </head>
  <body class="min-h-screen m-0 p-0">
    <!-- ESTRELLAS / BRILLOS (sobre fondoverde, detrás del contenido) -->
    <div id="estrellas" style="position:fixed;inset:0;z-index:0;pointer-events:none;overflow:hidden;"></div>

    <main class="m-0 p-0 overflow-x-hidden" style="position:relative;z-index:1;">
      <slot />
    </main>

    <!-- REVELAR CONTENIDO (anti-parpadeo): se activa en el frame siguiente a
         que corran los setups de animación, por lo que gsap.from() ya ocultó
         los elementos y no se ve el flash inicial. -->
    <script is:inline>
      (function () {
        function revelar() {
          requestAnimationFrame(function () {
            document.documentElement.classList.add("contenido-listo");
          });
        }
        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", revelar);
        } else {
          revelar();
        }
        // Fallback de seguridad por si algo falla.
        setTimeout(function () {
          document.documentElement.classList.add("contenido-listo");
        }, 1500);
      })();
    </script>

    <!-- GENERADOR DE ESTRELLAS -->
    <script>
      document.addEventListener("DOMContentLoaded", () => {
        const cont = document.getElementById("estrellas");
        if (!cont) return;
        const TOTAL = 60;
        for (let i = 0; i < TOTAL; i++) {
          const s = document.createElement("span");
          const size = Math.random() * 2.5 + 1; // 1–3.5px
          s.style.cssText =
            "position:absolute;border-radius:9999px;background:#ffffff;" +
            "left:" + Math.random() * 100 + "%;" +
            "top:" + Math.random() * 100 + "%;" +
            "width:" + size + "px;height:" + size + "px;" +
            "opacity:" + (Math.random() * 0.5 + 0.2) + ";" +
            "box-shadow:0 0 " + (size * 2.5) + "px rgba(255,255,255,0.8);" +
            "animation:brillo " + (Math.random() * 2.5 + 1.8) + "s ease-in-out " +
            (Math.random() * 3) + "s infinite;";
          cont.appendChild(s);
        }
      });
    </script>

    <!-- ANIMACIONES DE ENTRADA GLOBALES -->
    <script>
      import { gsap } from "gsap";
      import { ScrollTrigger } from "gsap/ScrollTrigger";
      gsap.registerPlugin(ScrollTrigger);

      // Todos los triggers recalculan posiciones cuando se llama refresh()
      ScrollTrigger.defaults({ invalidateOnRefresh: true });

      // ENTRADA ELEMENTO POR ELEMENTO
      // El contenedor con [data-entrada] solo marca el ámbito y dispara el
      // scroll; lo que se anima son sus [data-item], uno detrás de otro.
      //
      // El valor del atributo elige DE DÓNDE entra cada pieza:
      //   data-item          -> sube desde abajo (por defecto)
      //   data-item="izq"    -> entra deslizándose desde la izquierda
      //   data-item="der"    -> entra deslizándose desde la derecha
      // Las flores de los costados usan izq/der para que cada una venga de
      // su propio lado, en vez de subir todas igual.
      // Recorridos cortos y escala casi imperceptible: la entrada se nota
      // como algo que se posa, no como algo que salta.
      const DESDE = {
        "": { opacity: 0, x: 0, y: 22, scale: 0.99 },
        izq: { opacity: 0, x: -42, y: 0, scale: 0.985 },
        der: { opacity: 0, x: 42, y: 0, scale: 0.985 },
      };

      function ocultoDe(el) {
        return DESDE[el.getAttribute("data-item") || ""] || DESDE[""];
      }

      const yaPreparados = new WeakSet();

      // Si el componente no marcó piezas, entra como un bloque entero.
      function piezas(el) {
        const marcadas = el.querySelectorAll("[data-item]");
        return marcadas.length ? Array.from(marcadas) : [el];
      }

      function ocultar(objetivos) {
        objetivos.forEach((p) => gsap.set(p, ocultoDe(p)));
      }

      // "sine.out" frena de forma pareja, sin el tirón inicial de power3:
      // es lo que da la sensación delicada. La duración larga y el stagger
      // amplio hacen que las piezas se encadenen en vez de dispararse.
      function mostrar(objetivos) {
        gsap.to(objetivos, {
          opacity: 1,
          x: 0,
          y: 0,
          scale: 1,
          duration: 1.45,
          ease: "sine.out",
          stagger: 0.16,
          overwrite: "auto",
          // Al terminar se borra el transform inline que deja GSAP. Si no,
          // pisa para siempre los transform de CSS (los hover:scale-105 y
          // hover:-translate-y de los botones dejarían de funcionar).
          clearProps: "transform",
        });
      }

      function setupEntradas() {
        const sinMovimiento = window.matchMedia(
          "(prefers-reduced-motion: reduce)"
        ).matches;

        document.querySelectorAll("[data-entrada]").forEach((el) => {
          if (yaPreparados.has(el)) return;
          yaPreparados.add(el);

          const objetivos = piezas(el);

          if (sinMovimiento) {
            gsap.set(objetivos, { opacity: 1, x: 0, y: 0, scale: 1 });
            return;
          }

          ocultar(objetivos);

          // 1) ENTRADA: cuando el bloque asoma por abajo, las piezas van
          //    apareciendo escalonadas en el orden en que están en el HTML.
          ScrollTrigger.create({
            trigger: el,
            start: "top 88%",
            onEnter: () => mostrar(objetivos),
          });

          // 2) REARME: se vuelven a ocultar SOLO cuando el bloque salió por
          //    completo de la pantalla por abajo. Esta histéresis es la que
          //    quita el parpadeo: si se ocultaran en el mismo punto donde
          //    entran, al scrollear despacio sobre ese límite el componente
          //    se prendía y apagaba a cada píxel.
          ScrollTrigger.create({
            trigger: el,
            start: "top bottom",
            onLeaveBack: () => ocultar(objetivos),
          });
        });
      }

      document.addEventListener("DOMContentLoaded", setupEntradas);
      document.addEventListener("astro:page-load", setupEntradas);

      // Recalcula todas las posiciones cuando las imágenes ya cargaron.
      // En móvil DOMContentLoaded dispara antes de cargar imágenes,
      // dejando los trigger positions incorrectos.
      window.addEventListener("load", () => {
        setTimeout(() => ScrollTrigger.refresh(), 200);
      });
    </script>
  </body>
</html>
