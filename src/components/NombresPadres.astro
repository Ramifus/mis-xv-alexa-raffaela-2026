---
// NombresPadres.astro
---

<div
    data-entrada
    id="padres-contenedor"
    class="relative w-full overflow-hidden flex flex-col items-center justify-center text-center px-6 pt-2 pb-10"
>
    <!-- FLORES LATERALES -->
    <!-- El centrado va con flex y NO con -translate-y-1/2: GSAP escribe su
         propio transform al animar y borraría ese centrado. -->
    <div
        data-item="izq"
        class="pointer-events-none absolute left-0 inset-y-0 flex items-center w-[10%] max-w-[60px] z-0"
    >
        <img
            src="/imagenes/florlateral.png"
            alt=""
            class="select-none w-full h-auto"
        />
    </div>
    <div
        data-item="der"
        class="pointer-events-none absolute right-0 inset-y-0 flex items-center w-[10%] max-w-[60px] z-0"
    >
        <img
            src="/imagenes/florlateral.png"
            alt=""
            class="select-none w-full h-auto scale-x-[-1]"
        />
    </div>

    <!-- CONTENIDO -->
    <div class="relative z-10 flex flex-col items-center w-full">
    <!-- SILUETA -->
    <!-- <img
        src="/imagenes/silueta.png"
        alt=""
        data-item
        id="padres-silueta"
        class="pointer-events-none select-none block w-[70px] h-auto mb-6 opacity-100"
    /> -->

    <!-- SEPARADOR (flores + corona) -->
    <img
        src="/imagenes/separador2.png"
        alt=""
        data-item
        id="padres-separador"
        class="pointer-events-none select-none block w-[230px] h-auto"
    />

    <!-- CORAZÓN DE ROSAS -->
    <img
        src="/imagenes/rosa.png"
        alt=""
        data-item
        id="padres-rosa"
        class="pointer-events-none select-none block w-[62px] h-auto mt-7"
    />

    <!-- TÍTULO -->
    <p
        data-item
        id="padres-titulo"
        class="m-0 mt-7 font-romantic not-italic text-[#f1e9d6] text-[clamp(1.7rem,7vw,2.4rem)] leading-[1.7]"
    >
        Con la bendición<br />de mis Padres
    </p>

    <!-- NOMBRES -->
    <p
        data-item
        id="padres-nombres"
        class="m-0 mt-6 font-cormorant uppercase text-[#ffc065] text-[17px] tracking-normal leading-[2]"
    >
        Alex Gordillo<br />Carolina Reynolds
    </p>
    </div>
</div>

