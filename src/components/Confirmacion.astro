
<div
    data-entrada
    id="conf-contenedor"
    class="relative w-full overflow-hidden flex flex-col items-center justify-center text-center px-8 pt-2 pb-4"
>
    <!-- FLORES LATERALES -->
    <!-- El centrado va con flex y NO con -translate-y-1/2: GSAP escribe su
         propio transform al animar y borraría ese centrado. -->
    <div
        data-item="izq"
        class="pointer-events-none absolute left-0 inset-y-0 flex items-center w-[10%] max-w-[60px] z-0"
    >
        <img
            src="/imagenes/florlateral.png"
            alt=""
            class="select-none w-full h-auto"
        />
    </div>
    <div
        data-item="der"
        class="pointer-events-none absolute right-0 inset-y-0 flex items-center w-[10%] max-w-[60px] z-0"
    >
        <img
            src="/imagenes/florlateral.png"
            alt=""
            class="select-none w-full h-auto scale-x-[-1]"
        />
    </div>

    <!-- CONTENIDO -->
    <div class="relative z-10 flex flex-col items-center w-full">
    <!-- ROSA EN CÚPULA -->
    <img
        data-item
        id="conf-rosa"
        src="/imagenes/rosa2.png"
        alt="Rosa"
        class="w-[92px] h-auto select-none"
        draggable="false"
    />

    <!-- SEPARADOR CON CORONA -->
    <img
        data-item
        id="conf-separador"
        src="/imagenes/separador2.png"
        alt=""
        class="w-[210px] h-auto mt-5 select-none"
        draggable="false"
    />

    <!-- TÍTULO -->
    <h2
        data-item
        id="conf-titulo"
        class="m-0 mt-8 font-romantic text-[#ffc065] text-[clamp(2.2rem,10vw,2.9rem)] leading-[1.5]"
    >
        Confirma tu Asistencia
    </h2>

    <!-- TEXTO -->
    <p
        data-item
        id="conf-texto"
        class="m-0 mt-6 max-w-[300px] font-cormorant not-italic text-[#f1e9d6] text-[17px] leading-[1.7]"
    >
        Será de mucha alegría contar con tu presencia en este día tan importante
        para mí.
    </p>

    <!-- INDICACIÓN -->
    <p
        data-item
        id="conf-indicacion"
        class="m-0 mt-8 font-cormorant not-italic font-semibold uppercase text-[#ffc065] text-[14px] tracking-[0.12em] max-w-[300px]"
    >
        Haz clic en el botón para confirmar tu asistencia
    </p>

    <!-- FECHA LÍMITE (cuadro sutil y elegante) -->
    <div
        data-item
        id="conf-limite"
        class="mt-8 w-full max-w-[290px] rounded-2xl border border-[#ffc065]/30
               bg-white/[0.04] backdrop-blur-sm px-7 py-6 text-center
               shadow-[0_10px_30px_rgba(0,0,0,0.25)]"
    >
        <p
            class="m-0 font-cormorant not-italic text-[#f1e9d6]/90 text-[19px] leading-[1.55] tracking-[0.03em]"
        >
            Tu presencia es muy importante para mí, no olvides confirmar tu
            asistencia
        </p>

        <!-- adorno sutil -->
        <span
            class="mx-auto my-3 block h-px w-16 bg-gradient-to-r from-transparent via-[#ffc065]/60 to-transparent"
        ></span>

        <p
            class="m-0 font-cormorant not-italic font-semibold text-[#ffc065] text-[30px] leading-tight tracking-[0.04em]"
        >
            07 de Septiembre
        </p>
    </div>

    <!-- BOTÓN QUE ABRE EL MODAL DEL FORMULARIO -->
    <button
        data-item
        id="conf-abrir-modal"
        type="button"
        class="mt-8 inline-flex w-auto max-w-full items-center justify-center gap-2 rounded-full
               whitespace-nowrap
               bg-[#ffc065] px-7 py-3.5 font-cormorant not-italic font-semibold
               uppercase tracking-[0.08em] text-[#16304d] text-[clamp(12px,3.6vw,15px)]
               shadow-[0_10px_26px_rgba(0,0,0,0.35)]
               transition-all duration-300 hover:-translate-y-0.5 hover:opacity-90"
    >
        <svg
            class="w-[18px] h-[18px]"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
        >
            <path d="M20 6 9 17l-5-5"></path>
        </svg>
        Confirmar asistencia
    </button>
    </div>
</div>

<!-- ═══════════════════════════════════════════════════════════════
     MODAL DE CONFIRMACIÓN
     Envía el nombre a Google Sheets vía Apps Script (SCRIPT_URL).
     Va fuera de #conf-contenedor para que las animaciones GSAP y el
     overflow-hidden de la sección no lo afecten.
     ═══════════════════════════════════════════════════════════════ -->
<div
    id="conf-modal"
    class="fixed inset-0 z-[999] hidden items-center justify-center overflow-y-auto overscroll-contain px-5 py-8"
    role="dialog"
    aria-modal="true"
    aria-labelledby="conf-modal-titulo"
>
    <!-- FONDO OSCURO -->
    <div
        id="conf-modal-fondo"
        class="absolute inset-0 bg-black/70 backdrop-blur-sm opacity-0 transition-opacity duration-300"
    >
    </div>

    <!-- CAJA -->
    <div
        id="conf-modal-caja"
        class="relative w-full max-w-[380px] overflow-hidden rounded-[22px]
               border border-[#ffc065]/40 bg-[#16304d]
               shadow-[0_25px_60px_rgba(0,0,0,0.6)]
               opacity-0 scale-95 transition-all duration-300"
    >
        <!-- ENCABEZADO -->
        <div
            class="flex items-center justify-between border-b border-[#ffc065]/25 px-6 py-4"
        >
            <span
                class="font-cormorant not-italic text-[#f1e9d6] text-[17px] tracking-[0.06em]"
            >
                Confirmar Asistencia
            </span>
            <button
                id="conf-cerrar-modal"
                type="button"
                aria-label="Cerrar"
                class="text-[#f1e9d6]/70 transition-colors hover:text-[#ffc065]"
            >
                <svg
                    class="w-6 h-6"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                >
                    <path d="M18 6 6 18M6 6l12 12"></path>
                </svg>
            </button>
        </div>

        <!-- CUERPO -->
        <form id="conf-form" class="px-6 pb-7 pt-6 text-center">
            <h3
                id="conf-modal-titulo"
                class="m-0 font-romantic not-italic text-[#ffc065] text-[30px] leading-[1.35]"
            >
                Confirmación de Asistencia
            </h3>

            <p
                class="m-0 mt-2 font-cormorant not-italic text-[#f1e9d6]/80 text-[15px] leading-[1.5]"
            >
                Ingresa el nombre de las personas que asistirán:
            </p>

            <input
                id="conf-input-nombre"
                type="text"
                name="nombre"
                required
                autocomplete="name"
                placeholder="Nombre y apellido"
                class="mt-5 w-full rounded-xl border border-[#ffc065]/30
                       bg-white/[0.06] px-4 py-3
                       font-cormorant not-italic text-[#f1e9d6] text-[17px]
                       placeholder:text-[#f1e9d6]/45
                       outline-none transition-colors
                       focus:border-[#ffc065] focus:bg-white/[0.09]"
            />

            <button
                type="submit"
                class="mt-4 w-full rounded-full bg-[#ffc065] px-6 py-3.5
                       font-cormorant not-italic font-semibold text-[#16304d] text-[19px]
                       shadow-[0_10px_26px_rgba(0,0,0,0.35)]
                       transition-opacity duration-300 hover:opacity-90"
            >
                Enviar Confirmación
            </button>

            <!-- MENSAJE DE ERROR -->
            <p
                id="conf-form-mensaje"
                class="m-0 mt-4 hidden font-cormorant not-italic text-[#ff9d8a] text-[15px] leading-[1.5]"
            >
            </p>
        </form>

        <!-- PANEL DE ÉXITO (animado) -->
        <div
            id="conf-exito"
            class="hidden flex-col items-center px-6 pb-9 pt-8 text-center"
        >
            <!-- CHECK ANIMADO -->
            <div class="relative mx-auto h-[92px] w-[92px]">
                <span
                    id="conf-exito-anillo"
                    class="absolute inset-0 rounded-full border-2 border-[#ffc065]/50"
                ></span>
                <svg
                    id="conf-exito-svg"
                    viewBox="0 0 100 100"
                    class="absolute inset-0 h-full w-full"
                >
                    <circle
                        id="conf-exito-circulo"
                        cx="50"
                        cy="50"
                        r="42"
                        fill="none"
                        stroke="#ffc065"
                        stroke-width="4"
                        stroke-linecap="round"
                        transform="rotate(-90 50 50)"></circle>
                    <path
                        id="conf-exito-tilde"
                        d="M31 51.5 L44.5 65 L69 38"
                        fill="none"
                        stroke="#ffc065"
                        stroke-width="6"
                        stroke-linecap="round"
                        stroke-linejoin="round"></path>
                </svg>
            </div>

            <h3
                data-exito-item
                class="m-0 mt-6 font-romantic not-italic text-[#ffc065] text-[30px] leading-[1.3]"
            >
                ¡Confirmación recibida!
            </h3>

            <span
                data-exito-item
                class="mt-4 block h-px w-[120px] bg-gradient-to-r from-transparent via-[#ffc065]/60 to-transparent"
            ></span>

            <p
                id="conf-exito-nombre"
                data-exito-item
                class="m-0 mt-4 font-cormorant not-italic uppercase tracking-[0.18em] text-[#f1e9d6] text-[13px]"
            >
            </p>

            <p
                data-exito-item
                class="m-0 mt-3 font-cormorant not-italic text-[#f1e9d6]/80 text-[16px] leading-[1.6]"
            >
                Gracias por acompañarnos en este día tan especial.
            </p>

            <p
                data-exito-item
                class="m-0 mt-5 font-romantic not-italic text-[#ffc065] text-[26px] leading-[1.2]"
            >
                ¡Te esperamos!
            </p>
        </div>
    </div>
</div>

<script>
    import { gsap } from "gsap";

    // URL de la app web de Apps Script (hoja "Confirmaciones - XV años Alexa Raffaela")
    const SCRIPT_URL =
        "https://script.google.com/macros/s/AKfycbygOz7Iwy5lpNiet8Pi7rSAZSDhDo0DSMoMxGo1t19oo-fRkN4r3bjKBsqfzedyrEVt/exec";

    // La entrada de la sección la maneja el sistema global [data-entrada]
    // de Layout.astro; aquí solo vive la lógica del modal.

    function initConfModal() {
        const modal = document.getElementById("conf-modal");
        const fondo = document.getElementById("conf-modal-fondo");
        const caja = document.getElementById("conf-modal-caja");
        const abrir = document.getElementById("conf-abrir-modal");
        const cerrar = document.getElementById("conf-cerrar-modal");
        const form = document.getElementById("conf-form");
        const input = document.getElementById("conf-input-nombre");
        const mensaje = document.getElementById("conf-form-mensaje");
        if (!modal || !fondo || !caja || !abrir || !cerrar || !form) return;

        // initConfModal corre en DOMContentLoaded y en astro:page-load; sin
        // esto se registrarían dos listeners de submit y se guardaría la
        // confirmación por duplicado en la hoja.
        if (modal.dataset.iniciado === "1") return;
        modal.dataset.iniciado = "1";

        // El Layout hace scroll sobre <html>, así que hay que bloquear los
        // dos: con body solo, el fondo se seguía moviendo. overscroll-behavior
        // evita además que el scroll "se contagie" a la página al llegar al
        // final del modal.
        function bloquearScroll() {
            document.documentElement.style.overflow = "hidden";
            document.body.style.overflow = "hidden";
            document.body.style.overscrollBehavior = "none";
        }

        function liberarScroll() {
            document.documentElement.style.overflow = "";
            document.body.style.overflow = "";
            document.body.style.overscrollBehavior = "";
        }

        function abrirModal() {
            modal.classList.remove("hidden");
            modal.classList.add("flex");
            bloquearScroll();
            // El frame siguiente, para que la transición se vea.
            requestAnimationFrame(() => {
                fondo.classList.replace("opacity-0", "opacity-100");
                caja.classList.replace("opacity-0", "opacity-100");
                caja.classList.replace("scale-95", "scale-100");
            });
            setTimeout(() => input && input.focus(), 320);
        }

        function cerrarModal() {
            fondo.classList.replace("opacity-100", "opacity-0");
            caja.classList.replace("opacity-100", "opacity-0");
            caja.classList.replace("scale-100", "scale-95");
            liberarScroll();
            setTimeout(() => {
                modal.classList.add("hidden");
                modal.classList.remove("flex");
            }, 300);
        }

        abrir.addEventListener("click", abrirModal);
        cerrar.addEventListener("click", cerrarModal);
        fondo.addEventListener("click", cerrarModal);
        // iOS ignora overflow:hidden en algunos casos: si el dedo arrastra
        // sobre el fondo oscuro, se cancela el gesto.
        fondo.addEventListener(
            "touchmove",
            (e) => {
                e.preventDefault();
            },
            { passive: false },
        );
        document.addEventListener("keydown", (e) => {
            if (e.key === "Escape" && !modal.classList.contains("hidden")) {
                cerrarModal();
            }
        });

        // ── ENVÍO A GOOGLE SHEETS + ANIMACIÓN DE ÉXITO ─────────────
        const exito = document.getElementById("conf-exito");
        const exitoNombre = document.getElementById("conf-exito-nombre");
        const circulo = document.getElementById("conf-exito-circulo");
        const tilde = document.getElementById("conf-exito-tilde");
        const anillo = document.getElementById("conf-exito-anillo");
        const botonEnviar = form.querySelector('button[type="submit"]');
        const textoBotonEnviar = botonEnviar && botonEnviar.textContent;

        let enviando = false;
        let yaConfirmo = false;

        function mostrarExito(nombre) {
            if (!exito) return;
            if (exitoNombre) exitoNombre.textContent = nombre;

            form.classList.add("hidden");
            exito.classList.remove("hidden");
            exito.classList.add("flex");

            // preparar los trazos para dibujarlos
            [circulo, tilde].forEach((trazo) => {
                if (!trazo) return;
                const largo = trazo.getTotalLength();
                gsap.set(trazo, {
                    strokeDasharray: largo,
                    strokeDashoffset: largo,
                });
            });

            gsap.timeline()
                .fromTo(
                    "#conf-exito-svg",
                    { scale: 0.6, opacity: 0 },
                    { scale: 1, opacity: 1, duration: 0.4, ease: "back.out(2)" },
                )
                .to(
                    circulo,
                    { strokeDashoffset: 0, duration: 0.65, ease: "power2.inOut" },
                    "-=0.15",
                )
                .to(
                    tilde,
                    { strokeDashoffset: 0, duration: 0.4, ease: "power2.out" },
                    "-=0.15",
                )
                .fromTo(
                    anillo,
                    { scale: 0.9, opacity: 0.7 },
                    {
                        scale: 1.45,
                        opacity: 0,
                        duration: 0.9,
                        ease: "power2.out",
                        transformOrigin: "50% 50%",
                    },
                    "-=0.25",
                )
                .fromTo(
                    exito.querySelectorAll("[data-exito-item]"),
                    { opacity: 0, y: 18 },
                    {
                        opacity: 1,
                        y: 0,
                        duration: 0.5,
                        stagger: 0.12,
                        ease: "power2.out",
                    },
                    "-=0.7",
                );

            setTimeout(cerrarModal, 3600);
        }

        function mostrarError(texto) {
            if (!mensaje) return;
            mensaje.textContent = texto;
            mensaje.classList.remove("hidden");
        }

        form.addEventListener("submit", async (e) => {
            e.preventDefault();
            if (enviando || !input) return;

            const nombre = input.value.trim().replace(/\s+/g, " ");

            if (nombre.length < 3) {
                mostrarError("Por favor escribe el nombre y apellido.");
                gsap.fromTo(
                    input,
                    { x: -8 },
                    { x: 0, duration: 0.5, ease: "elastic.out(1, 0.3)" },
                );
                return;
            }

            enviando = true;
            mensaje && mensaje.classList.add("hidden");
            if (botonEnviar) {
                botonEnviar.disabled = true;
                botonEnviar.textContent = "Enviando...";
                botonEnviar.classList.add("opacity-70");
            }

            // urlencoded: Apps Script lo lee directo en e.parameter.nombre
            const datos = new URLSearchParams();
            datos.append("nombre", nombre);

            try {
                const respuesta = await fetch(SCRIPT_URL, {
                    method: "POST",
                    headers: {
                        "Content-Type":
                            "application/x-www-form-urlencoded;charset=UTF-8",
                    },
                    body: datos.toString(),
                });

                const cuerpo = await respuesta.text();
                console.log("[Confirmar] respuesta de Google:", cuerpo);

                if (!respuesta.ok || /"?(ok"?\s*:\s*false|error)/i.test(cuerpo)) {
                    throw new Error(cuerpo);
                }

                yaConfirmo = true;
                form.reset();
                mostrarExito(nombre);
            } catch (error) {
                console.error("[Confirmar] fallo el envio:", error);
                mostrarError("Hubo un error de conexión, intenta de nuevo.");
                enviando = false;
                if (botonEnviar) {
                    botonEnviar.disabled = false;
                    botonEnviar.textContent = textoBotonEnviar;
                    botonEnviar.classList.remove("opacity-70");
                }
            }
        });

        // si ya confirmó, al reabrir se ve el agradecimiento, no el formulario
        abrir.addEventListener("click", () => {
            if (!yaConfirmo || !exito) return;
            form.classList.add("hidden");
            exito.classList.remove("hidden");
            exito.classList.add("flex");
        });
    }

    document.addEventListener("DOMContentLoaded", () => {
        initConfModal();
    });
    document.addEventListener("astro:page-load", () => {
        initConfModal();
    });
</script>
